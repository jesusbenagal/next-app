generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum ProductType {
    PALA
    ZAPATILLA
    BOLA
    TEXTIL
    ACCESORIO
}

model User {
    id        String   @id @default(cuid())
    email     String   @unique
    name      String?
    role      String   @default("USER")
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    orders    Order[]
}

model Brand {
    id       String    @id @default(cuid())
    name     String
    slug     String    @unique
    products Product[]

    @@index([slug])
}

model Category {
    id       String    @id @default(cuid())
    name     String
    slug     String    @unique
    products Product[]

    @@index([slug])
}

model Product {
    id             String      @id @default(cuid())
    name           String
    slug           String      @unique
    type           ProductType
    brandId        String
    categoryId     String
    description    String      @db.Text
    seoTitle       String?
    seoDescription String?
    active         Boolean     @default(true)

    // Atributos técnicos básicos (opcionales por tipo)
    // PALA: peso/balance/forma; ZAPATILLA: talla; etc.
    weightGr Int?
    balance  String? // head-light / even / head-heavy
    shape    String? // redonda / lágrima / diamante

    brand     Brand            @relation(fields: [brandId], references: [id], onDelete: Restrict)
    category  Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
    variants  ProductVariant[]
    images    ProductImage[]
    createdAt DateTime         @default(now())
    updatedAt DateTime         @updatedAt

    @@index([brandId])
    @@index([categoryId])
}

model ProductVariant {
    id         String  @id @default(cuid())
    productId  String
    sku        String  @unique
    priceCents Int // sin decimales para precisión
    stock      Int     @default(0)
    color      String?
    size       String? // EU 42 / M / etc.
    gripSize   String? // para PALA
    ean13      String? @unique

    product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
    OrderItem OrderItem[]

    @@index([productId])
}

model ProductImage {
    id        String @id @default(cuid())
    productId String
    url       String
    alt       String

    product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Order {
    id              String      @id @default(cuid())
    userId          String?
    status          String      @default("DRAFT") // Día 11: PAID/FULFILLED/CANCELLED
    totalCents      Int         @default(0)
    currency        String      @default("EUR")
    paymentProvider String? // stripe / redsys
    externalId      String?     @unique
    items           OrderItem[]
    user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
    createdAt       DateTime    @default(now())
    updatedAt       DateTime    @updatedAt
}

model OrderItem {
    id         String @id @default(cuid())
    orderId    String
    variantId  String
    qty        Int
    priceCents Int

    order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
    variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
}
